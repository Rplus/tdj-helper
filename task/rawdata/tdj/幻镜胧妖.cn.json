    "weapon": [
      {
        "weapon": "幻镜胧妖",
        "name": "寒冰凌",
        "img": "Weapon_bingling",
        "qixue": "36",
        "magic": "38",
        "physical": "0",
        "feature": "",
        "rarity": "N",
        "jiesuo": "",
        "desc": "传，寒冰凌乃奇门之兵。因胧妖囚于幻镜之中，借镜中玄力，引极寒之气，炼化宿玉所得。<br/>故，寒冰凌为独门之器，只待其修炼心法，将符咒之力融入其中，而得提升。<br/>传，寒冰凌有妖术加持，可增益胧妖结境之术，实属利器也。"
      },
      {
        "weapon": "幻镜胧妖",
        "name": "玄冰凌",
        "img": "Weapon_hanbingling",
        "qixue": "44",
        "magic": "47",
        "physical": "0",
        "feature": "[决明]伤害提升5%",
        "rarity": "R",
        "jiesuo": "英灵位阶25",
        "desc": "<br/>传，玄冰凌乃觅宝镜中上乘心法，以「乌金玄铁」炼成。<br/>虽以妖术炼制，其威力亦不容小觑。以妖术炼仙法，本是背驰之事，然非水火不相容矣。妖仙两性，凝结其中，玄法之冰凌矣。言：冲风结玄冰，道恶不可履。巫咸上天去，泽冻神蓍死。"
      },
      {
        "weapon": "幻镜胧妖",
        "name": "冷月寒凌",
        "img": "Weapon_lengyuehanling",
        "qixue": "54",
        "magic": "58",
        "physical": "0",
        "feature": "[决明]伤害提升5%<br/>[天魁]法术伤害减免提升5%",
        "rarity": "SR",
        "jiesuo": "列星回响消耗45点天魂之力",
        "desc": "<br/>载，洞府仙人号冷月，云浆未饮结成冰。如何雪月交光夜，更在瑶台十二层。<br/>传，仙人潜入上古宝镜中，以月之精气破除镜中结界，难遁走，遂化身为冰，眠此中。<br/>传，冷月寒凌即为吸收了月之灵气，再以「化渊玉钢」炼化而成之寒冰凌矣。言：霜和冷月，又起凄风，至阴至寒之器矣。"
      },
      {
        "weapon": "幻镜胧妖",
        "name": "冰魄之心",
        "img": "Weapon_bingpozhixin",
        "qixue": "68",
        "magic": "73",
        "physical": "0",
        "feature": "[决明]伤害提升5%<br/>[天魁]法术伤害减免提升5%<br/>[锁心]气血高于50%时，进入对战后伤害提升10%",
        "rarity": "SSR",
        "jiesuo": "列星回响消耗74点天魂之力",
        "desc": "传，冰魄之心非轻易炼成，话外，乃水神赴渚宫云宴，长醉后跌入仙池，随身法器沉入池底，下界修炼成水中大妖，后遭伏诛，取其心，为记。<br/>传，冰魄之心由仙入魔，历劫而成。言：今人古人共磨灭，惟有冰心埋不得，万古鱼龙护冰魄，一睨辟易惊世人。"
      }
